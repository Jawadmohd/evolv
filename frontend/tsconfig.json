{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "customConditions": ["import", "require"],
    "paths": {
      "@expo/vector-icons": ["./node_modules/@expo/vector-icons/build/Icons.d.ts"],
      "@hookform/resolvers/zod": ["./node_modules/@hookform/resolvers/zod/dist/index.d.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
